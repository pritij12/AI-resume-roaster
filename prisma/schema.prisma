// One table: every roast is saved here
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Roast {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  score     Int
  roast     String
  createdAt DateTime @default(now())
}
